{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.length >= 16",
        ".write": "auth != null && $room.length >= 16"
      }
    },
    "guests": {
      "$code": {
        ".read": "auth != null && $code.length >= 16",
        ".write": "auth != null && $code.length >= 16"
      }
    }
  }
}
